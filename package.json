{
  "name": "server-management",
  "version": "2.0.0",
  "description": "Tracks which QA/staging environments are free and which are held by a Jira ticket, so nobody has to ask in chat before deploying.",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:import": "tsx scripts/import-legacy.ts",
    "legacy": "node server/index.js",
    "test": "node --import tsx --test tests/*.test.ts",
    "auth:list": "tsx scripts/set-password.ts list",
    "auth:set-password": "tsx scripts/set-password.ts set-password",
    "verify:chat": "tsx scripts/verify-chat.mts",
    "verify:chat:http": "tsx scripts/verify-chat-http.mts",
    "verify:chat:social": "tsx scripts/verify-chat-social.mts",
    "verify:avatar": "tsx scripts/verify-avatar.mts",
    "verify:presence": "tsx scripts/verify-presence.mts",
    "auth:unlock": "tsx scripts/set-password.ts unlock",
    "verify:pusher": "tsx scripts/verify-pusher.mts",
    "verify:health": "tsx scripts/verify-health.mts",
    "check:secrets": "tsx scripts/check-staged-secrets.mts",
    "verify:chat:files": "tsx scripts/verify-chat-files.mts",
    "verify:link-preview": "tsx scripts/verify-link-preview.mts",
    "verify:chat:mentions": "tsx scripts/verify-chat-mentions.mts",
    "verify:tickets": "tsx scripts/verify-tickets.mts",
    "verify:team": "tsx scripts/verify-team.mts",
    "verify:pwa": "tsx scripts/verify-pwa.mts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/blob": "^2.8.0",
    "next": "^15.5.4",
    "nextjs-toploader": "^3.9.17",
    "pusher": "^5.3.4",
    "pusher-js": "^8.6.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^24.7.0",
    "@types/react": "^19.1.11",
    "@types/react-dom": "^19.1.7",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/romemadeloo/server-management.git"
  },
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/romemadeloo/server-management/issues"
  },
  "homepage": "https://github.com/romemadeloo/server-management#readme"
}
